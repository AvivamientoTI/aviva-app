# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Dashboard -> Project Settings -> API
#
# These are the ONLY variables the frontend reads. src/services/supabaseClient.ts
# throws at startup if either of the first two is missing.

# Supabase project URL.
VITE_SUPABASE_URL=https://fltxsqdzbwydjdokadwu.supabase.co

# The anon/publishable key. Safe to expose — it ships in the browser bundle and
# every table is protected by RLS. Do NOT put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Optional. Error reporting; leave blank to disable.
VITE_SENTRY_DSN=

# ----------------------------------------------------------------------------
# These same two values must also be set in:
#   - Vercel   -> Project Settings -> Environment Variables (runtime + build)
#   - GitHub   -> Settings -> Secrets and variables -> Actions
#                 (.github/workflows/ci.yml reads VITE_SUPABASE_URL and
#                  VITE_SUPABASE_ANON_KEY for the test, build and e2e jobs)
#
# Edge Function secrets are configured separately, in the Supabase dashboard
# under Edge Functions -> Secrets. They are NOT read from this file:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY  auto-injected by Supabase
#   HOOK_SECRET                              auth-claims-admin (Auth Hook)
#   FUNCTION_SECRET                          check-birthdays, notify-attendance
#   GROQ_API_KEY                             chat-ai
#   GMAIL_APP_PASSWORD, GMAIL_SENDER_EMAIL   check-birthdays, notify-attendance
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
#   TWILIO_WHATSAPP_FROM                     notify-attendance
#   SENTRY_DSN                               auth-claims-admin, chat-ai,
#                                            check-birthdays
# ----------------------------------------------------------------------------
